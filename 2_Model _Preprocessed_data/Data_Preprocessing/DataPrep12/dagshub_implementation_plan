- Update `start_run()` to handle DagsHub client initialization or manual credentials setup:
```python
            # Resolve DagsHub integration first if specified
            if Config.MLFLOW_DAGSHUB_REPO:
                try:
                    import dagshub
                    repo_owner, repo_name = Config.MLFLOW_DAGSHUB_REPO.split('/')
                    logger.info(f"[MLflow] Initializing DagsHub Client: {Config.MLFLOW_DAGSHUB_REPO}")
                    dagshub.init(repo_owner=repo_owner, repo_name=repo_name, mlflow=True)
                except ImportError:
                    logger.warning("[MLflow] 'dagshub' package not found. Falling back to basic HTTP authentication.")
                    if Config.MLFLOW_TRACKING_USERNAME:
                        os.environ["MLFLOW_TRACKING_USERNAME"] = Config.MLFLOW_TRACKING_USERNAME
                    if Config.MLFLOW_TRACKING_PASSWORD:
                        os.environ["MLFLOW_TRACKING_PASSWORD"] = Config.MLFLOW_TRACKING_PASSWORD
                except Exception as e:
                    logger.error(f"[MLflow] Failed to initialize DagsHub client: {e}")
            else:
                # Manual credential fallback (also handles non-DagsHub basic auth endpoints)
                if Config.MLFLOW_TRACKING_USERNAME:
                    os.environ["MLFLOW_TRACKING_USERNAME"] = Config.MLFLOW_TRACKING_USERNAME
                if Config.MLFLOW_TRACKING_PASSWORD:
                    os.environ["MLFLOW_TRACKING_PASSWORD"] = Config.MLFLOW_TRACKING_PASSWORD

            # Configure tracking backend
            self.mlflow.set_tracking_uri(Config.MLFLOW_TRACKING_URI)
